<?xml version='1.0' encoding='utf-8'?>
<widget id="com.fatzoexpress.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Fatzo Express</name>
    <description>Mobile pre-order gateway for lechon and catering services.</description>
    <content src="admin.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <preference name="loglevel" value="DEBUG" />
    <preference name="Orientation" value="default" />
</widget>
